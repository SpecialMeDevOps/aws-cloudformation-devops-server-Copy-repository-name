{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Backend availability, HTTP request metrics, ECS resource utilization, and process resource usage.",
  "editable": false,
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showPercentChange": false,
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "up{job=\"it-your-it-house-backend\"}",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "title": "Backend service availability",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "id": 2,
      "options": {
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "expr": "up",
          "legendFormat": "{{job}} {{instance}}",
          "refId": "A"
        }
      ],
      "title": "Prometheus scrape target health",
      "type": "gauge"
    },
    {
      "datasource": {
        "type": "cloudwatch",
        "uid": "cloudwatch"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "cores"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "id": 3,
      "targets": [
        {
          "dimensions": {
            "ClusterName": "it-your-it-house-dev-cluster",
            "ServiceName": "it-your-it-house-dev-frontend"
          },
          "metricName": "CPUUtilized",
          "namespace": "ECS/ContainerInsights",
          "period": "60",
          "region": "us-east-1",
          "refId": "A",
          "statistic": "Average"
        },
        {
          "dimensions": {
            "ClusterName": "it-your-it-house-dev-cluster",
            "ServiceName": "it-your-it-house-dev-backend"
          },
          "metricName": "CPUUtilized",
          "namespace": "ECS/ContainerInsights",
          "period": "60",
          "region": "us-east-1",
          "refId": "B",
          "statistic": "Average"
        }
      ],
      "title": "ECS service CPU utilization",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "cloudwatch",
        "uid": "cloudwatch"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "mebibytes"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 11
      },
      "id": 4,
      "targets": [
        {
          "dimensions": {
            "ClusterName": "it-your-it-house-dev-cluster",
            "ServiceName": "it-your-it-house-dev-frontend"
          },
          "metricName": "MemoryUtilized",
          "namespace": "ECS/ContainerInsights",
          "period": "60",
          "region": "us-east-1",
          "refId": "A",
          "statistic": "Average"
        },
        {
          "dimensions": {
            "ClusterName": "it-your-it-house-dev-cluster",
            "ServiceName": "it-your-it-house-dev-backend"
          },
          "metricName": "MemoryUtilized",
          "namespace": "ECS/ContainerInsights",
          "period": "60",
          "region": "us-east-1",
          "refId": "B",
          "statistic": "Average"
        }
      ],
      "title": "ECS service memory utilization",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 11
      },
      "id": 5,
      "targets": [
        {
          "expr": "sum by (route, status_code) (rate(http_requests_total[5m]))",
          "legendFormat": "{{route}} {{status_code}}",
          "refId": "A"
        }
      ],
      "title": "Backend HTTP request rate",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "cores"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "id": 6,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{route}} p95",
          "refId": "A"
        }
      ],
      "title": "Backend HTTP request latency (p95)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 25
      },
      "id": 7,
      "targets": [
        {
          "expr": "process_resident_memory_bytes",
          "legendFormat": "Backend process",
          "refId": "A"
        }
      ],
      "title": "Backend process memory",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 25
      },
      "id": 8,
      "targets": [
        {
          "expr": "rate(process_cpu_user_seconds_total[5m]) + rate(process_cpu_system_seconds_total[5m])",
          "legendFormat": "Backend process",
          "refId": "A"
        }
      ],
      "title": "Backend process CPU usage",
      "type": "timeseries"
    }
  ],
  "refresh": "15s",
  "schemaVersion": 41,
  "tags": [
    "it-your-it-house",
    "aws-managed-monitoring"
  ],
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "title": "IT Your IT House - Application Health",
  "uid": "it-your-it-house-health",
  "version": 1
}
