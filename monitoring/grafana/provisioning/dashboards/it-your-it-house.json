      "id": 1,
      "options": {
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "expr": "min(up{namespace=\"it-your-it-house-dev\"})",
          "legendFormat": "Backend metrics endpoint",
          "refId": "A"
        }
      ],
      "title": "Backend scrape health",
      "type": "gauge"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 8, "x": 8, "y": 0 },
      "id": 2,
      "options": {
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "expr": "sum(kube_pod_status_ready{namespace=\"it-your-it-house-dev\", condition=\"true\"})",
          "legendFormat": "Ready pods",
          "refId": "A"
        }
      ],
      "title": "Kubernetes ready pods",
      "type": "gauge"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": { "unit": "cores" },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 12, "x": 16, "y": 0 },
      "id": 3,
      "targets": [
        {
          "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"it-your-it-house-dev\", container!=\"\", image!=\"\"}[5m]))",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ],
      "title": "Application pod CPU",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": { "unit": "bytes" },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 5 },
      "id": 4,
      "targets": [
        {
          "expr": "sum by (pod) (container_memory_working_set_bytes{namespace=\"it-your-it-house-dev\", container!=\"\", image!=\"\"})",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ],
      "title": "Application pod memory",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": { "unit": "reqps" },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 5 },
      "id": 5,
      "targets": [
        {
          "expr": "sum by (route, status_code) (rate(http_requests_total{namespace=\"it-your-it-house-dev\"}[5m]))",
          "legendFormat": "{{route}} {{status_code}}",
          "refId": "A"
        }
      ],
      "title": "Backend HTTP request rate",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": { "unit": "s" },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 11 },
      "id": 6,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(http_request_duration_seconds_bucket{namespace=\"it-your-it-house-dev\"}[5m])))",
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ],
      "title": "Backend request latency (p95)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": { "unit": "cores" },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 11 },
      "id": 7,
      "targets": [
        {
          "expr": "sum by (instance) (rate(node_cpu_seconds_total{mode!=\"idle\"}[5m]))",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "title": "EKS node CPU",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
